{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CostWatch",
  "version": "0.1.2",
  "identifier": "com.costwatch.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "CostWatch",
        "width": 308,
        "height": 350,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "url": "/popover"
      },
      {
        "label": "settings",
        "title": "CostWatch Settings",
        "width": 640,
        "height": 480,
        "decorations": true,
        "resizable": false,
        "visible": false,
        "url": "/settings"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}